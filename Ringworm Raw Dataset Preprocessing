ngworm\"\nOUTPUT_PATH = \"/kaggle/working/preprocessed\"\nos.makedirs(OUTPUT_PATH, exist_ok=True)\n\n# Utility function to compare images and show percentage change\ndef compare_images(original, processed, title1='Original', title2='Processed', step=''):\n    # Resize both images to the same shape if they differ\n    if original.shape != processed.shape:\n        processed = cv2.resize(processed, (original.shape[1], original.shape[0]), interpolation=cv2.INTER_AREA)\n\n    grayA = cv2.cvtColor(original, cv2.COLOR_RGB2GRAY)\n    grayB = cv2.cvtColor(processed, cv2.COLOR_RGB2GRAY)\n    score, _ = ssim(grayA, grayB, full=True)\n    diff_percent = (1 - score) * 100\n\n    fig, axes = plt.subplots(1, 2, figsize=(10, 5))\n    axes[0].imshow(original)\n    axes[0].set_title(title1)\n    axes[0].axis(\"off\")\n\n    axes[1].imshow(processed)\n    axes[1].set_title(f\"{title2}\\nChange: {diff_percent:.2f}%\")\n    axes[1].axis(\"off\")\n\n    plt.suptitle(f\"Comparison after {step}\")\n    plt.tight_layout()\n    plt.show()\n\n# Load image filenames\nimage_files = [f for f in os.listdir(DATASET_PATH) if f.endswith(('.png', '.jpg', '.jpeg'))]\n\n# Process first 5 images as an example\nfor file in image_files[:5]:\n    img_path = os.path.join(DATASET_PATH, file)\n    img = cv2.imread(img_path)\n    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n\n    # Step 1: Resize to 512x512\n    resized = cv2.resize(img, (512, 512), interpolation=cv2.INTER_AREA)\n    compare_images(img, resized, step=\"Image Resizing\")\n\n    # Step 2: Digital Hair Removal using Black Hat Morphological Operation\n    gray = cv2.cvtColor(resized, cv2.COLOR_RGB2GRAY)\n    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (17, 17))\n    blackhat = cv2.morphologyEx(gray, cv2.MORPH_BLACKHAT, kernel)\n    _, thresh = cv2.threshold(blackhat, 10, 255, cv2.THRESH_BINARY)\n\n    # Inpaint to remove hair\n    inpainted = cv2.inpaint(resized, thresh, 1, cv2.INPAINT_TELEA)\n    compare_images(resized, inpainted, step=\"Digital Hair Removal\")\n\n    # Step 3: Noise Reduction using Gaussian Filtering\n    denoised = gaussian_filter(inpainted, sigma=1)\n    compare_images(inpainted, denoised, step=\"Noise Reduction\")\n\n    # Save the final preprocessed image\n    save_path = os.path.join(OUTPUT_PATH, f\"preprocessed_{file}\")\n    cv2.imwrite(save_path, cv2.cvtColor(denoised, cv2.COLOR_RGB2BGR))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-12T15:16:13.923627Z","iopub.execute_input":"2025-04-12T15:16:13.923984Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":null}]}